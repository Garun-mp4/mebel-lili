# Server only. Never prefix these variables with VITE_.
# Enable only after filling legal/operator.mjs and checking Russian server, storage and processors.
LEADS_RU_HOSTING_CONFIRMED=false
# Absolute path OUTSIDE the application, on a persistent private Russian server volume.
LEADS_DATA_DIR=
# 32 random bytes as 64 hexadecimal characters. Keep separate from data and backups.
LEADS_ENCRYPTION_KEY=
# Only behind a private reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional: notifications contain only a random lead ID, never client fields.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional build-time ownership codes from the owner's search accounts.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
